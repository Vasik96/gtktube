{
  "id" : "org.vasik96.GtkTube",
  "runtime" : "org.gnome.Platform",
  "runtime-version" : "49",
  "runtime-commit" : "2bb946ea4ebb050f6a32f90e979feb975b08280d1ff1aac881dec3d1361ad84d",
  "sdk" : "org.gnome.Sdk",
  "sdk-commit" : "faf37bdc962236ef8e61fd0b289fd311f7961cc5a7b4bc11a6e29506d7874003",
  "command" : "gtktube",
  "modules" : [
    {
      "name" : "gtktube",
      "buildsystem" : "simple",
      "sources" : [
        {
          "path" : "main.py",
          "type" : "file"
        },
        {
          "path" : "org.vasik96.GtkTube.desktop",
          "type" : "file"
        },
        {
          "path" : "org.vasik96.GtkTube.svg",
          "type" : "file"
        }
      ],
      "build-commands" : [
        "install -Dm644 main.py /app/share/gtktube/main.py",
        "install -d /app/bin",
        "printf '%s\n' '#!/bin/sh' 'exec /usr/bin/python3 /app/share/gtktube/main.py \"$@\"' > /app/bin/gtktube",
        "chmod 755 /app/bin/gtktube",
        "install -Dm644 org.vasik96.GtkTube.desktop /app/share/applications/org.vasik96.GtkTube.desktop",
        "install -Dm644 org.vasik96.GtkTube.svg /app/share/icons/hicolor/scalable/apps/org.vasik96.GtkTube.svg"
      ]
    }
  ],
  "finish-args" : [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=pulseaudio",
    "--filesystem=host:ro",
    "--filesystem=home",
    "--filesystem=xdg-run/dconf",
    "--talk-name=ca.desrt.dconf",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.portal.Settings",
    "--filesystem=/usr/share/themes:ro",
    "--filesystem=xdg-data/themes:ro"
  ],
  "source-date-epoch" : 1792314018
}